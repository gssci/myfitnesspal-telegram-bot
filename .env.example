MFP_USERNAME=you@example.com
MFP_PASSWORD=your-password
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=http://localhost:11434
MFP_AGENT_TIMEZONE=Europe/Rome
MFP_AGENT_DEBUG=true
MFP_AGENT_LOG=logs/agent-debug.jsonl
# Set true only when you also want complete prompts in the local trace.
MFP_AGENT_LOG_PROMPTS=false
# Number of recent user/assistant turns retained separately for each chat.
MFP_CHAT_HISTORY_TURNS=6

# Telegram bot interface (create a token with BotFather).
TELEGRAM_BOT_TOKEN=replace-with-a-new-bot-token
# Required for access: comma-separated numeric Telegram user IDs.
# With no IDs configured, /start reports your ID but all agent requests are denied.
TELEGRAM_ALLOWED_USER_IDS=123456789
